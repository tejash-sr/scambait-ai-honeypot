# ============================================
# KAVACH — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# Set these in Vercel Dashboard → Settings → Environment Variables
# ============================================

# PRIMARY: Groq API key (FASTEST - 200ms latency, free 14,400 req/day)
# Get FREE key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_key_here

# SECONDARY: Google Gemini API key (3-model cascade)
# Get FREE key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# TERTIARY: Anthropic Claude API key (best quality, paid)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# API key for authenticating incoming requests (REQUIRED)
# Judges will send this as x-api-key header
API_KEY=fae26946fc2015d9bd6f1ddbb447e2f7

# Server Configuration (local Express dev only)
PORT=3000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# GUVI Callback URL (do not change unless instructed)
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult
